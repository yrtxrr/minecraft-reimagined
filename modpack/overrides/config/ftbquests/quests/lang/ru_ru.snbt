{
  "quest.5245494D00000101.title": "Первые шаги",
  "quest.5245494D00000101.quest_desc": [
    "Создайте первый предмет. Затем сделайте верстак: это основа дальнейшего развития."
  ],
  "quest.5245494D00000102.title": "Первые инструменты",
  "quest.5245494D00000102.quest_desc": [
    "Изготовьте инструмент: например деревянную кирку или топор."
  ],
  "quest.5245494D00000103.title": "Убежище",
  "quest.5245494D00000103.quest_desc": [
    "Поставьте кровать в безопасном месте и лягте спать. Признак — ванильное достижение сна."
  ],
  "quest.5245494D00000104.title": "Еда и природа",
  "quest.5245494D00000104.quest_desc": [
    "Съешьте еду. Плавка металла, рыбалка и убийство врага не заменяют приём пищи."
  ],
  "quest.5245494D00000105.title": "Сезоны и знания",
  "quest.5245494D00000105.quest_desc": [
    "Откройте журнал исследований. С Serene Seasons сезон проверяйте по его календарю: старый HUD может отличаться."
  ],
  "quest.5245494D00000106.title": "Под землёй",
  "quest.5245494D00000106.quest_desc": [
    "Добудьте рудный блок. Возьмите факелы и подходящую кирку."
  ],
  "quest.5245494D00000107.title": "Первый контакт",
  "quest.5245494D00000107.quest_desc": [
    "Совершите оплаченную сделку с жителем или поселенцем. Открытие окна и наличие изумруда недостаточны."
  ],
  "quest.5245494D00000108.title": "Выбор направления",
  "quest.5245494D00000108.quest_desc": [
    "Изучите доступные технологии и магию. Подтвердите готовность выбрать путь; можно развивать оба направления. Это не блокирует рецепты и не требует всех остальных заданий."
  ],
  "chapter.5245494D00000100.title": "Первые шаги",
  "task.5245494D10000101.title": "Первые шаги",
  "task.5245494D10000102.title": "Первые инструменты",
  "task.5245494D10000103.title": "Убежище",
  "task.5245494D10000104.title": "Еда и природа",
  "task.5245494D10000105.title": "Сезоны и знания",
  "task.5245494D10000106.title": "Под землёй",
  "task.5245494D10000107.title": "Первый контакт",
  "task.5245494D10000108.title": "Выбор направления"
}
