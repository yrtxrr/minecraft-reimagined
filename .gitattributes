# Normalize line endings for a cross-platform Gradle/Minecraft project.
# Text files are stored in the repository with LF and stay LF in the working tree.
* text=auto eol=lf

# Windows launchers keep CRLF so that cmd.exe and Git for Windows behave predictably.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be converted.
*.jar binary
*.png binary
*.ogg binary
*.ttf binary
*.zip binary

# Preserve the exact uploaded R7 lock bytes (including CRLF) as immutable evidence.
pack/r8/baseline/r7-installed.lock.json binary
pack/r8/party-a/evidence.json binary
